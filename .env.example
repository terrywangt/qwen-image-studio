# ===== Qwen Image Studio 部署配置 =====
# 复制为 .env 并修改; 本文件只放非敏感默认值

# --- Web (Next.js) ---
# 代理服务地址(compose 内直接用服务名 proxy)
PROXY_BASE_URL=http://proxy:3264/api
# 访问代理所需 API key(对应 proxy/src/Authorization.txt 里的 key)
PROXY_API_KEY=change-me
PORT=3000

# --- Proxy (FreeQwenApi) ---
HOST=0.0.0.0
PORT=3264
NON_INTERACTIVE=1
SKIP_ACCOUNT_MENU=1
REQUIRE_API_KEYS=true
QWEN_USE_NODE_FETCH=0
QWEN_TOOL_PROMPT_MODE=minimal
QWEN_MAX_SYSTEM_CHARS=180000
PAGE_POOL_SIZE=3
TOKEN_HEALTH_CHECK_INTERVAL_MS=3600000